<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

    <!--
	   Наследование от spring-boot-starter-parent - это родительский POM
	   от Spring Boot, который предоставляет:
	   - Управление версиями зависимостей
	   - Конфигурацию плагинов по умолчанию
	   - Стандартные настройки сборки
	-->

    <parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.4.3</version>
		<relativePath/> <!-- Искать в удалённом репозитории, если нет локально -->
	</parent>
	<groupId>com.mark</groupId>
	<artifactId>ref-tg-bot</artifactId>
	<version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ref-system</name>
	<description>Tg bot referal system</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
    <modules>
        <module>discovery-server</module>
        <module>ref-application</module>
    </modules>
    <scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
    </properties>
	<dependencies>
        <!-- Spring Boot Starter для веб-приложений (включает Tomcat, Spring MVC) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

        <!-- Lombok - библиотека для сокращения boilerplate кода
             (геттеры, сеттеры, конструкторы через аннотации) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
        </dependency>
	</dependencies>

    <!--
        Dependency Management - управление версиями зависимостей для всех модулей.
        Особенно важно для Spring Cloud компонентов.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- BOM (Bill of Materials) Spring Cloud - определяет совместимые версии
                 всех Spring Cloud компонентов -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
