<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="001_create_user_schema" author="Mark Krasnokutsky (generated)">
        <createTable tableName="user">
            <column name="user_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="chat_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="registered_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="indv_ref_code" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="ref_user_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_ref_user_id"
                             referencedTableName="user"
                             referencedColumnNames="user_id"/>
            </column>
            <column name="friend_ref_code" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="balance" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="total_referrals" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_user_chat_id"
                     tableName="user"
                     unique="true">
            <column name="chat_id"/>
        </createIndex>
        <createIndex indexName="idx_user_id"
                     tableName="user"
                     unique="true">
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="idx_ref_user_id"
                     tableName="user">
        <column name="ref_user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>