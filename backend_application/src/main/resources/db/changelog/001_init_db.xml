<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="001-create-qr-table" author="Mark Krasnokutsky">
        <createTable tableName="qr_codes">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="owner_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>

            <column name="data_json" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="qr_image" type="BYTEA">
                <constraints nullable="false"/>
            </column>

            <column name="file_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="content_type" type="VARCHAR(100)" defaultValue="image/png"/>

            <column name="redirect_url" type="VARCHAR">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>